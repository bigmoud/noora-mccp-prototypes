# Copy to .env and fill in. Never commit .env.

# ---- Extractor ---------------------------------------------------------------
# Leave the key blank to run the offline keyword baseline (nothing leaves your laptop).
# Use a key from the Claude Corps / Noora Console account, never a personal one,
# with a monthly spend cap and an alert set in the Console.
ANTHROPIC_API_KEY=
# Only if the key isn't scoped to one workspace: Console → Settings → Workspaces (starts wrkspc_)
ANTHROPIC_WORKSPACE_ID=
EXTRACTOR_MODEL=claude-haiku-5-5
# Haiku 5.5 list prices per million tokens (prompts under 100k). Change if you change model.
PRICE_INPUT_PER_MTOK=0.10
PRICE_OUTPUT_PER_MTOK=0.50
# Hard ceiling on total API spend across the server and the eval. Set the same cap in the Console.
SPEND_CAP_USD=5

# ---- Limits (enforced in code) -----------------------------------------------
DAILY_TOKEN_CAP=200000
MAX_EXTRACTIONS_PER_FAMILY_PER_HOUR=20
MAX_MESSAGE_CHARS=1500

# ---- Behaviour ---------------------------------------------------------------
# shadow | review_first | auto_with_audit   (can also be changed live in the dashboard)
ROLLOUT_MODE=auto_with_audit

# ---- Privacy -----------------------------------------------------------------
# Long random string. If blank, one is generated into data/.pseudonym_key on first run.
PSEUDONYM_KEY=
MESSAGE_RETENTION_HOURS=72

# ---- WhatsApp Cloud API (live demo only) -------------------------------------
WHATSAPP_LIVE=false
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
# Any string you choose; paste the same value into Meta's webhook settings.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_VERSION=v21.0
# Your own phones only, country code first, no "+", comma-separated (max 5 in Meta test mode).
ALLOWED_TEST_NUMBERS=

# ---- Dashboard ---------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
# Leave blank to get a new random token each start (printed in the terminal).
DASHBOARD_TOKEN=

# ---- Hosted frontend --------------------------------------------------------
# Origins of the hosted dashboard allowed to call this server (comma-separated, no trailing /)
ALLOWED_ORIGINS=
